{"definitions":[{"problemId":"iv.cpp.move-only-buffer","version":1,"ioDescription":"stdin: n then n ints. Move the owning buffer twice; stdout: final buffer elements, then the size of the moved-from buffer (0).","cases":[{"id":"visible.1","name":"move transfers ownership","hidden":false,"category":"normal","stdin":"3\n1 2 3\n","expectedStdout":"1 2 3\n0\n"},{"id":"hidden.2","name":"empty buffer","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":"\n0\n"},{"id":"hidden.3","name":"single element","hidden":true,"category":"boundary","stdin":"1\n42\n","expectedStdout":"42\n0\n"},{"id":"hidden.4","name":"negatives","hidden":true,"category":"adversarial","stdin":"4\n-1 -2 0 5\n","expectedStdout":"-1 -2 0 5\n0\n"}]},{"problemId":"iv.cpp.rule-of-five-buffer","version":1,"ioDescription":"stdin: n then n ints. Deep-copy the owner and mutate the copy's first element to 999; stdout: original elements, then copy elements.","cases":[{"id":"visible.1","name":"deep copy independence","hidden":false,"category":"normal","stdin":"3\n5 6 7\n","expectedStdout":"5 6 7\n999 6 7\n"},{"id":"hidden.2","name":"empty owner","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":"\n\n"},{"id":"hidden.3","name":"single element","hidden":true,"category":"boundary","stdin":"1\n8\n","expectedStdout":"8\n999\n"},{"id":"hidden.4","name":"larger","hidden":true,"category":"adversarial","stdin":"5\n10 20 30 40 50\n","expectedStdout":"10 20 30 40 50\n999 20 30 40 50\n"}]},{"problemId":"iv.cpp.special-member-dispatch","version":1,"ioDescription":"stdin: n then n op tokens from {copyctor,movector,copyassign,moveassign}. stdout: one line of C/M/c/m recording which special member ran.","cases":[{"id":"visible.1","name":"all four operations","hidden":false,"category":"normal","stdin":"4\ncopyctor movector copyassign moveassign\n","expectedStdout":"CMcm\n"},{"id":"hidden.2","name":"copies only","hidden":true,"category":"boundary","stdin":"2\ncopyctor copyassign\n","expectedStdout":"Cc\n"},{"id":"hidden.3","name":"moves only","hidden":true,"category":"boundary","stdin":"2\nmovector moveassign\n","expectedStdout":"Mm\n"},{"id":"hidden.4","name":"repeated","hidden":true,"category":"adversarial","stdin":"5\ncopyctor copyctor movector moveassign copyassign\n","expectedStdout":"CCMmc\n"}]},{"problemId":"iv.cpp.return-by-value","version":1,"ioDescription":"stdin: a name line. Return the greeting by value. stdout: Hello, <name>!","cases":[{"id":"visible.1","name":"name","hidden":false,"category":"normal","stdin":"World\n","expectedStdout":"Hello, World!\n"},{"id":"hidden.2","name":"spaces in name","hidden":true,"category":"boundary","stdin":"Ada Lovelace\n","expectedStdout":"Hello, Ada Lovelace!\n"},{"id":"hidden.3","name":"empty name","hidden":true,"category":"boundary","stdin":"\n","expectedStdout":"Hello, !\n"},{"id":"hidden.4","name":"punctuation","hidden":true,"category":"adversarial","stdin":"O'Brien-42\n","expectedStdout":"Hello, O'Brien-42!\n"}]},{"problemId":"iv.cpp.raii-file-wrapper","version":1,"ioDescription":"stdin: n then n (name action) pairs; action is ok or fail. RAII releases exactly once on every exit. stdout: open/close (and caught on fail) lines.","cases":[{"id":"visible.1","name":"ok then fail","hidden":false,"category":"normal","stdin":"2\ndb ok cache fail\n","expectedStdout":"open db\nclose db\nopen cache\nclose cache\ncaught cache\n"},{"id":"hidden.2","name":"all ok","hidden":true,"category":"boundary","stdin":"2\na ok b ok\n","expectedStdout":"open a\nclose a\nopen b\nclose b\n"},{"id":"hidden.3","name":"all fail","hidden":true,"category":"adversarial","stdin":"2\nx fail y fail\n","expectedStdout":"open x\nclose x\ncaught x\nopen y\nclose y\ncaught y\n"},{"id":"hidden.4","name":"none","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":""}]},{"problemId":"iv.cpp.unique-ptr-transfer","version":1,"ioDescription":"stdin: n then n ints. Transfer each unique_ptr into a sink. stdout: sum, then count of now-null sources.","cases":[{"id":"visible.1","name":"transfer three","hidden":false,"category":"normal","stdin":"3\n10 20 30\n","expectedStdout":"60\n3\n"},{"id":"hidden.2","name":"empty","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":"0\n0\n"},{"id":"hidden.3","name":"single","hidden":true,"category":"boundary","stdin":"1\n7\n","expectedStdout":"7\n1\n"},{"id":"hidden.4","name":"negatives","hidden":true,"category":"adversarial","stdin":"4\n-5 5 -3 3\n","expectedStdout":"0\n4\n"}]},{"problemId":"iv.cpp.shared-ptr-cycle","version":1,"ioDescription":"stdin: two node names. Model a two-node relationship without a shared_ptr cycle (weak back-edge). stdout: alive <n> where n is 0 after both owners drop.","cases":[{"id":"visible.1","name":"cycle broken","hidden":false,"category":"normal","stdin":"A B\n","expectedStdout":"alive 0\n"},{"id":"hidden.2","name":"other names","hidden":true,"category":"boundary","stdin":"root leaf\n","expectedStdout":"alive 0\n"},{"id":"hidden.3","name":"numeric names","hidden":true,"category":"adversarial","stdin":"1 2\n","expectedStdout":"alive 0\n"}]},{"problemId":"iv.cpp.ownership-boundary","version":1,"ioDescription":"stdin: n then n (id value) owned widgets, then q then q lookup ids. Borrow through a non-owning pointer. stdout: value or absent per query.","cases":[{"id":"visible.1","name":"lookups","hidden":false,"category":"normal","stdin":"2\n1 100 2 200\n3\n2 1 9\n","expectedStdout":"200\n100\nabsent\n"},{"id":"hidden.2","name":"all absent","hidden":true,"category":"boundary","stdin":"1\n5 50\n2\n7 8\n","expectedStdout":"absent\nabsent\n"},{"id":"hidden.3","name":"empty registry","hidden":true,"category":"boundary","stdin":"0\n\n2\n1 2\n","expectedStdout":"absent\nabsent\n"},{"id":"hidden.4","name":"repeat lookups","hidden":true,"category":"adversarial","stdin":"3\n1 10 2 20 3 30\n3\n3 3 1\n","expectedStdout":"30\n30\n10\n"}]},{"problemId":"iv.cpp.exception-safe-resource","version":1,"ioDescription":"stdin: first second mode; mode is ok or fail. Acquire two resources exception-safely; the first must release if the second step fails. stdout: acquire/release (and recovered) lines.","cases":[{"id":"visible.1","name":"second step fails","hidden":false,"category":"normal","stdin":"conn txn fail\n","expectedStdout":"acquire conn\nrelease conn\nrecovered\n"},{"id":"hidden.2","name":"both succeed","hidden":true,"category":"boundary","stdin":"conn txn ok\n","expectedStdout":"acquire conn\nacquire txn\nrelease txn\nrelease conn\n"},{"id":"hidden.3","name":"other names fail","hidden":true,"category":"adversarial","stdin":"file lock fail\n","expectedStdout":"acquire file\nrelease file\nrecovered\n"}]},{"problemId":"iv.cpp.object-slicing","version":1,"ioDescription":"stdin: n then n shape tokens (circle/square). Store polymorphically to avoid slicing. stdout: each shape's name.","cases":[{"id":"visible.1","name":"mixed shapes","hidden":false,"category":"normal","stdin":"3\ncircle square circle\n","expectedStdout":"circle\nsquare\ncircle\n"},{"id":"hidden.2","name":"single","hidden":true,"category":"boundary","stdin":"1\nsquare\n","expectedStdout":"square\n"},{"id":"hidden.3","name":"all circles","hidden":true,"category":"adversarial","stdin":"4\ncircle circle circle circle\n","expectedStdout":"circle\ncircle\ncircle\ncircle\n"}]},{"problemId":"iv.cpp.polymorphic-clone","version":1,"ioDescription":"stdin: n then n animal tokens (dog/cat). Deep-copy the owned polymorphic objects via a virtual clone. stdout: each clone's sound.","cases":[{"id":"visible.1","name":"dog and cat","hidden":false,"category":"normal","stdin":"2\ndog cat\n","expectedStdout":"woof\nmeow\n"},{"id":"hidden.2","name":"single","hidden":true,"category":"boundary","stdin":"1\ndog\n","expectedStdout":"woof\n"},{"id":"hidden.3","name":"all cats","hidden":true,"category":"adversarial","stdin":"3\ncat cat cat\n","expectedStdout":"meow\nmeow\nmeow\n"}]},{"problemId":"iv.cpp.override-mismatch","version":1,"ioDescription":"stdin: n then n ints. Call a correctly-overridden virtual (doubles) through a base pointer. stdout: doubled value per line.","cases":[{"id":"visible.1","name":"three values","hidden":false,"category":"normal","stdin":"3\n3 5 7\n","expectedStdout":"6\n10\n14\n"},{"id":"hidden.2","name":"zero and negative","hidden":true,"category":"boundary","stdin":"2\n0 -4\n","expectedStdout":"0\n-8\n"},{"id":"hidden.3","name":"single","hidden":true,"category":"boundary","stdin":"1\n11\n","expectedStdout":"22\n"}]},{"problemId":"iv.cpp.self-assignment-safe","version":1,"ioDescription":"stdin: n then n ints. Self-assign the owning array safely (guarded/copy-and-swap). stdout: elements, intact.","cases":[{"id":"visible.1","name":"self assign keeps data","hidden":false,"category":"normal","stdin":"3\n8 9 10\n","expectedStdout":"8 9 10\n"},{"id":"hidden.2","name":"empty","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":"\n"},{"id":"hidden.3","name":"single","hidden":true,"category":"boundary","stdin":"1\n42\n","expectedStdout":"42\n"}]}]}
