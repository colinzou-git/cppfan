{"definitions":[{"problemId":"iv.cpp.erase-while-iterating","version":1,"ioDescription":"stdin: n then n ints then k. Erase every multiple of k while traversing. stdout: remaining elements.","cases":[{"id":"visible.1","name":"remove multiples of 2","hidden":false,"category":"normal","stdin":"6\n1 2 3 4 5 6\n2\n","expectedStdout":"1 3 5\n"},{"id":"hidden.2","name":"remove all","hidden":true,"category":"adversarial","stdin":"3\n2 4 6\n2\n","expectedStdout":"\n"},{"id":"hidden.3","name":"remove none","hidden":true,"category":"boundary","stdin":"3\n1 3 5\n2\n","expectedStdout":"1 3 5\n"},{"id":"hidden.4","name":"k=0 removes none","hidden":true,"category":"boundary","stdin":"3\n1 2 3\n0\n","expectedStdout":"1 2 3\n"}]},{"problemId":"iv.cpp.unordered-map-no-insert","version":1,"ioDescription":"stdin: n then n (key value), then q then q keys. Look up without operator[] insertion. stdout: value/absent per query, then size <n>.","cases":[{"id":"visible.1","name":"present and absent","hidden":false,"category":"normal","stdin":"2\na 1 b 2\n3\na c b\n","expectedStdout":"1\nabsent\n2\nsize 2\n"},{"id":"hidden.2","name":"all absent keeps size","hidden":true,"category":"boundary","stdin":"1\nk 9\n2\nx y\n","expectedStdout":"absent\nabsent\nsize 1\n"},{"id":"hidden.3","name":"empty map","hidden":true,"category":"boundary","stdin":"0\n\n2\np q\n","expectedStdout":"absent\nabsent\nsize 0\n"}]},{"problemId":"iv.cpp.lambda-capture-lifetime","version":1,"ioDescription":"stdin: n then n ints. Capture by value so callables stay valid after the loop. stdout: square of each captured value.","cases":[{"id":"visible.1","name":"three squares","hidden":false,"category":"normal","stdin":"3\n2 3 4\n","expectedStdout":"4\n9\n16\n"},{"id":"hidden.2","name":"single","hidden":true,"category":"boundary","stdin":"1\n7\n","expectedStdout":"49\n"},{"id":"hidden.3","name":"negatives","hidden":true,"category":"adversarial","stdin":"3\n-2 0 5\n","expectedStdout":"4\n0\n25\n"}]},{"problemId":"iv.cpp.string-view-lifetime","version":1,"ioDescription":"stdin: a line. Return the first whitespace-delimited token as an owning string. stdout: the token.","cases":[{"id":"visible.1","name":"leading spaces","hidden":false,"category":"normal","stdin":"  hello world foo\n","expectedStdout":"hello\n"},{"id":"hidden.2","name":"single token","hidden":true,"category":"boundary","stdin":"solo\n","expectedStdout":"solo\n"},{"id":"hidden.3","name":"empty line","hidden":true,"category":"boundary","stdin":"\n","expectedStdout":"\n"}]},{"problemId":"iv.cpp.strict-weak-comparator","version":1,"ioDescription":"stdin: n then n (name priority). Sort by priority asc, name asc with a valid strict-weak comparator. stdout: name priority per line.","cases":[{"id":"visible.1","name":"tie broken by name","hidden":false,"category":"normal","stdin":"3\nbob 2\nann 2\ncy 1\n","expectedStdout":"cy 1\nann 2\nbob 2\n"},{"id":"hidden.2","name":"single","hidden":true,"category":"boundary","stdin":"1\nsolo 5\n","expectedStdout":"solo 5\n"},{"id":"hidden.3","name":"all same priority","hidden":true,"category":"adversarial","stdin":"3\nc 1\nb 1\na 1\n","expectedStdout":"a 1\nb 1\nc 1\n"}]},{"problemId":"iv.cpp.reserve-vs-resize","version":1,"ioDescription":"stdin: n then n ints. reserve capacity then push_back; size must equal count. stdout: size <n>, then the elements.","cases":[{"id":"visible.1","name":"reserve then push","hidden":false,"category":"normal","stdin":"4\n1 2 3 4\n","expectedStdout":"size 4\n1 2 3 4\n"},{"id":"hidden.2","name":"empty","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":"size 0\n\n"},{"id":"hidden.3","name":"single","hidden":true,"category":"boundary","stdin":"1\n9\n","expectedStdout":"size 1\n9\n"}]},{"problemId":"iv.cpp.template-deduction","version":1,"ioDescription":"stdin: a b, then n, then n ints. Deduce T for a max template and a container-size template. stdout: max(a,b), then the count.","cases":[{"id":"visible.1","name":"max and count","hidden":false,"category":"normal","stdin":"7 3\n4\n9 1 8 2\n","expectedStdout":"7\n4\n"},{"id":"hidden.2","name":"a greater","hidden":true,"category":"boundary","stdin":"10 -5\n0\n","expectedStdout":"10\n0\n"},{"id":"hidden.3","name":"equal","hidden":true,"category":"adversarial","stdin":"5 5\n2\n1 2\n","expectedStdout":"5\n2\n"}]},{"problemId":"iv.cpp.if-constexpr-dispatch","version":1,"ioDescription":"stdin: n then n (tag value); tag i uses the integral branch (v*2), tag s uses the string branch (v+!). stdout: int:<2v> or str:<v>! per line.","cases":[{"id":"visible.1","name":"mixed branches","hidden":false,"category":"normal","stdin":"3\ni 5\ns hi\ni 10\n","expectedStdout":"int:10\nstr:hi!\nint:20\n"},{"id":"hidden.2","name":"strings only","hidden":true,"category":"boundary","stdin":"2\ns a\ns bb\n","expectedStdout":"str:a!\nstr:bb!\n"},{"id":"hidden.3","name":"ints only","hidden":true,"category":"boundary","stdin":"2\ni 0\ni -3\n","expectedStdout":"int:0\nint:-6\n"}]},{"problemId":"iv.cpp.generic-static-contract","version":1,"ioDescription":"stdin: n then n ints. Sum of squares via a template guarded by static_assert(is_arithmetic). stdout: the sum of squares.","cases":[{"id":"visible.1","name":"sum of squares","hidden":false,"category":"normal","stdin":"3\n2 3 4\n","expectedStdout":"29\n"},{"id":"hidden.2","name":"empty is zero","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":"0\n"},{"id":"hidden.3","name":"negatives","hidden":true,"category":"adversarial","stdin":"3\n-2 -3 4\n","expectedStdout":"29\n"}]},{"problemId":"iv.cpp.sanitizer-use-after-free","version":1,"ioDescription":"stdin: n, n ints, appends, that many ints, then idx. Index the vector after appends (no saved dangling reference). stdout: element at idx or oob.","cases":[{"id":"visible.1","name":"index after growth","hidden":false,"category":"normal","stdin":"2\n5 6\n3\n7 8 9\n4\n","expectedStdout":"9\n"},{"id":"hidden.2","name":"index zero after growth","hidden":true,"category":"boundary","stdin":"1\n1\n2\n2 3\n0\n","expectedStdout":"1\n"},{"id":"hidden.3","name":"out of bounds","hidden":true,"category":"adversarial","stdin":"1\n1\n1\n2\n9\n","expectedStdout":"oob\n"}]},{"problemId":"iv.cpp.signed-unsigned-loop","version":1,"ioDescription":"stdin: n then n ints. Count adjacent increasing pairs with a correct signed loop (no size()-1 underflow when empty). stdout: the count.","cases":[{"id":"visible.1","name":"some increases","hidden":false,"category":"normal","stdin":"5\n1 3 2 4 4\n","expectedStdout":"2\n"},{"id":"hidden.2","name":"empty no underflow","hidden":true,"category":"boundary","stdin":"0\n\n","expectedStdout":"0\n"},{"id":"hidden.3","name":"strictly increasing","hidden":true,"category":"adversarial","stdin":"4\n1 2 3 4\n","expectedStdout":"3\n"}]},{"problemId":"iv.cpp.optional-parse","version":1,"ioDescription":"stdin: n then n tokens. Parse each as an int via std::optional; sum valid, count failures. stdout: sum, then failure count.","cases":[{"id":"visible.1","name":"one bad token","hidden":false,"category":"normal","stdin":"4\n10 x -5 12\n","expectedStdout":"17\n1\n"},{"id":"hidden.2","name":"all valid","hidden":true,"category":"boundary","stdin":"3\n1 2 3\n","expectedStdout":"6\n0\n"},{"id":"hidden.3","name":"all invalid","hidden":true,"category":"adversarial","stdin":"3\na bb c\n","expectedStdout":"0\n3\n"}]}]}
