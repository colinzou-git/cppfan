{
  "definitions": [
    {
      "problemId": "iv.dp.longest-increasing-subsequence",
      "version": 1,
      "ioDescription": "stdin: n followed by n integers. stdout: length of the longest strictly increasing subsequence.",
      "cases": [
        {
          "id": "visible.mixed",
          "name": "mixed sequence",
          "hidden": false,
          "category": "normal",
          "stdin": "8\n10 9 2 5 3 7 101 18\n",
          "expectedStdout": "4\n"
        },
        {
          "id": "hidden.decreasing",
          "name": "strictly decreasing",
          "hidden": true,
          "category": "boundary",
          "stdin": "5\n5 4 3 2 1\n",
          "expectedStdout": "1\n"
        },
        {
          "id": "hidden.duplicates",
          "name": "all equal",
          "hidden": true,
          "category": "adversarial",
          "stdin": "6\n2 2 2 2 2 2\n",
          "expectedStdout": "1\n"
        }
      ]
    },
    {
      "problemId": "iv.design.snapshot-array",
      "version": 1,
      "ioDescription": "stdin: length q, then q commands: set i value, snap, get i snapId. stdout: snap ids and get results in operation order.",
      "cases": [
        {
          "id": "visible.history",
          "name": "snapshot separation",
          "hidden": false,
          "category": "normal",
          "stdin": "3 7\nset 0 5\nsnap\nset 0 6\nget 0 0\nsnap\nget 0 1\nget 1 0\n",
          "expectedStdout": "0\n5\n1\n6\n0\n"
        },
        {
          "id": "hidden.default",
          "name": "default value in old snapshot",
          "hidden": true,
          "category": "boundary",
          "stdin": "1 4\nsnap\nget 0 0\nset 0 7\nget 0 0\n",
          "expectedStdout": "0\n0\n0\n"
        },
        {
          "id": "hidden.coalesce",
          "name": "multiple sets and snapshots",
          "hidden": true,
          "category": "adversarial",
          "stdin": "2 8\nset 1 3\nset 1 4\nsnap\nset 1 -2\nsnap\nget 1 0\nget 1 1\nget 0 1\n",
          "expectedStdout": "0\n1\n4\n-2\n0\n"
        }
      ]
    },
    {
      "problemId": "iv.design.time-key-value",
      "version": 1,
      "ioDescription": "stdin: q, then q commands: set key value timestamp or get key timestamp. stdout: one value or '-' for each get.",
      "cases": [
        {
          "id": "visible.timeline",
          "name": "reads across versions",
          "hidden": false,
          "category": "normal",
          "stdin": "7\nset foo bar 1\nset foo baz 4\nget foo 1\nget foo 3\nget foo 4\nget foo 5\nget nope 5\n",
          "expectedStdout": "bar\nbar\nbaz\nbaz\n-\n"
        },
        {
          "id": "hidden.before",
          "name": "query before first version",
          "hidden": true,
          "category": "boundary",
          "stdin": "3\nset a x 10\nget a 9\nget a 10\n",
          "expectedStdout": "-\nx\n"
        },
        {
          "id": "hidden.keys",
          "name": "independent key histories",
          "hidden": true,
          "category": "adversarial",
          "stdin": "6\nset a one 1\nset b two 2\nset a three 3\nget a 2\nget b 9\nget c 9\n",
          "expectedStdout": "one\ntwo\n-\n"
        },
        {
          "id": "hidden.scale",
          "name": "wide timestamp gap",
          "hidden": true,
          "category": "scale",
          "stdin": "4\nset k v1 1\nset k v2 100\nget k 99\nget k 100\n",
          "expectedStdout": "v1\nv2\n"
        }
      ]
    },
    {
      "problemId": "iv.list.clone-random-links",
      "version": 1,
      "ioDescription": "stdin: n, n values, then n random indices (-1 for null). stdout: one 'value randomIndex' line per cloned node.",
      "cases": [
        {
          "id": "visible.cross",
          "name": "cross-linked nodes",
          "hidden": false,
          "category": "normal",
          "stdin": "3\n10 20 30\n2 -1 0\n",
          "expectedStdout": "10 2\n20 -1\n30 0\n"
        },
        {
          "id": "hidden.self",
          "name": "self-random",
          "hidden": true,
          "category": "boundary",
          "stdin": "1\n7\n0\n",
          "expectedStdout": "7 0\n"
        },
        {
          "id": "hidden.empty",
          "name": "empty list",
          "hidden": true,
          "category": "adversarial",
          "stdin": "0\n\n\n",
          "expectedStdout": ""
        }
      ]
    },
    {
      "problemId": "iv.graph.robot-room-exploration",
      "version": 1,
      "ioDescription": "stdin: rows cols startRow startCol, then rows strings of . and #. stdout: number of reachable open cells.",
      "cases": [
        {
          "id": "visible.maze",
          "name": "reachable region",
          "hidden": false,
          "category": "normal",
          "stdin": "4 5 0 0\n..#..\n.##..\n.....\n#....\n",
          "expectedStdout": "16\n"
        },
        {
          "id": "hidden.blocked",
          "name": "blocked start",
          "hidden": true,
          "category": "boundary",
          "stdin": "2 2 0 0\n#.\n..\n",
          "expectedStdout": "0\n"
        },
        {
          "id": "hidden.cross",
          "name": "connected around walls",
          "hidden": true,
          "category": "adversarial",
          "stdin": "3 3 1 1\n.#.\n...\n.#.\n",
          "expectedStdout": "7\n"
        }
      ]
    },
    {
      "problemId": "iv.graph.k-stop-cheapest-route",
      "version": 1,
      "ioDescription": "stdin: n m src dst k, followed by m lines u v weight. stdout: cheapest price or -1.",
      "cases": [
        {
          "id": "visible.limit",
          "name": "two-edge constrained route",
          "hidden": false,
          "category": "normal",
          "stdin": "4 5 0 3 1\n0 1 100\n1 2 100\n2 3 100\n0 2 500\n0 3 700\n",
          "expectedStdout": "600\n"
        },
        {
          "id": "hidden.more-stops",
          "name": "extra stop unlocks cheaper route",
          "hidden": true,
          "category": "boundary",
          "stdin": "4 5 0 3 2\n0 1 100\n1 2 100\n2 3 100\n0 2 500\n0 3 700\n",
          "expectedStdout": "300\n"
        },
        {
          "id": "hidden.unreachable",
          "name": "destination unreachable",
          "hidden": true,
          "category": "adversarial",
          "stdin": "3 1 0 2 1\n0 1 5\n",
          "expectedStdout": "-1\n"
        },
        {
          "id": "hidden.scale",
          "name": "full stop budget",
          "hidden": true,
          "category": "scale",
          "stdin": "5 5 0 4 3\n0 1 1\n1 2 1\n2 3 1\n3 4 1\n0 4 10\n",
          "expectedStdout": "4\n"
        }
      ]
    },
    {
      "problemId": "iv.graph.reconstruct-itinerary",
      "version": 1,
      "ioDescription": "stdin: m followed by m directed airport pairs. stdout: airport sequence separated by spaces, starting at JFK.",
      "cases": [
        {
          "id": "visible.branch",
          "name": "lexical Euler trail",
          "hidden": false,
          "category": "normal",
          "stdin": "4\nJFK SFO\nJFK ATL\nSFO ATL\nATL JFK\n",
          "expectedStdout": "JFK ATL JFK SFO ATL\n"
        },
        {
          "id": "hidden.single",
          "name": "single ticket",
          "hidden": true,
          "category": "boundary",
          "stdin": "1\nJFK LAX\n",
          "expectedStdout": "JFK LAX\n"
        },
        {
          "id": "hidden.circuit",
          "name": "cycles and lexical choices",
          "hidden": true,
          "category": "adversarial",
          "stdin": "6\nJFK B\nJFK A\nA JFK\nA C\nC A\nB A\n",
          "expectedStdout": "JFK A C A JFK B A\n"
        }
      ]
    },
    {
      "problemId": "iv.graph.alien-order",
      "version": 1,
      "ioDescription": "stdin: n followed by n words. stdout: lexicographically smallest valid character order, or INVALID.",
      "cases": [
        {
          "id": "visible.order",
          "name": "inferred chain",
          "hidden": false,
          "category": "normal",
          "stdin": "5\nwrt\nwrf\ner\nett\nrftt\n",
          "expectedStdout": "wertf\n"
        },
        {
          "id": "hidden.prefix",
          "name": "invalid prefix order",
          "hidden": true,
          "category": "boundary",
          "stdin": "2\nabc\nab\n",
          "expectedStdout": "INVALID\n"
        },
        {
          "id": "hidden.cycle",
          "name": "precedence cycle",
          "hidden": true,
          "category": "adversarial",
          "stdin": "3\nz\nx\nz\n",
          "expectedStdout": "INVALID\n"
        }
      ]
    },
    {
      "problemId": "iv.graph.multi-source-spread",
      "version": 1,
      "ioDescription": "stdin: rows cols followed by grid integers: -1 blocked, 0 empty, 1 inactive target, 2 active source. stdout: minutes to activate all targets or -1.",
      "cases": [
        {
          "id": "visible.layers",
          "name": "single source layered spread",
          "hidden": false,
          "category": "normal",
          "stdin": "3 3\n2 1 1\n1 1 0\n0 1 1\n",
          "expectedStdout": "4\n"
        },
        {
          "id": "hidden.unreachable",
          "name": "separated target",
          "hidden": true,
          "category": "boundary",
          "stdin": "1 3\n2 0 1\n",
          "expectedStdout": "-1\n"
        },
        {
          "id": "hidden.block",
          "name": "spread around obstacle",
          "hidden": true,
          "category": "adversarial",
          "stdin": "2 3\n2 -1 1\n1 1 1\n",
          "expectedStdout": "4\n"
        }
      ]
    },
    {
      "problemId": "iv.graph.zero-one-grid-route",
      "version": 1,
      "ioDescription": "stdin: rows cols followed by 0/1 cell costs. stdout: minimum cost from top-left to bottom-right, excluding the start cell.",
      "cases": [
        {
          "id": "visible.zero-path",
          "name": "all-zero detour",
          "hidden": false,
          "category": "normal",
          "stdin": "3 3\n0 1 1\n0 0 1\n1 0 0\n",
          "expectedStdout": "0\n"
        },
        {
          "id": "hidden.ones",
          "name": "all moves cost one",
          "hidden": true,
          "category": "boundary",
          "stdin": "2 2\n0 1\n1 1\n",
          "expectedStdout": "2\n"
        },
        {
          "id": "hidden.single",
          "name": "single cell",
          "hidden": true,
          "category": "adversarial",
          "stdin": "1 1\n1\n",
          "expectedStdout": "0\n"
        }
      ]
    }
  ]
}
